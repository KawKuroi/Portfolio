---
/*
  Escena 0 — Portada, minima: disciplina, nombre y una frase | retrato. En telefono el retrato
  baja, apaisado. El retrato degrada con onerror a un placeholder (.ept).
  Copy bilingue por idioma vigente (el nombre propio del H1 no se traduce).
*/
import { obtenerIdioma, obtenerTextos } from '../../i18n/ui';

const t = obtenerTextos(obtenerIdioma(Astro.currentLocale));
---

<section class="scene title" id="portada" data-slate={t.slates.portada}>
  <div class="wrap">
    <div class="title-grid">
      <div class="title-main">
        <p class="kick">{t.portada.kick}</p>
        <h1><span>Kevin Axel</span> <em>Herazo Rolón</em></h1>
        <p class="resumen">{t.portada.resumen}</p>
      </div>

      <figure class="portrait">
        <img
          src="/assets/me/retrato.webp"
          width="720"
          height="900"
          alt={t.portada.retratoAlt}
          fetchpriority="high"
          onerror="this.closest('.portrait').classList.add('empty')"
        />
        <span class="ept"><svg class="ic"><use href="#ic-portrait" /></svg><span>{t.portada.retratoPlaceholder}</span></span>
      </figure>
    </div>
  </div>
</section>

<style>
  .title-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(230px, min(31vw, (100dvh - 130px) * .8), 416px);
    align-items: center;
    column-gap: clamp(28px, 5vw, 72px);
  }

  .title-main {
    min-width: 0;
  }

  .kick {
    font-family: var(--mono);
    font-size: var(--t-etiqueta);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--acento-texto);
    margin-bottom: clamp(12px, 2.6vh, 26px);
  }

  h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(3rem, min(1rem + 6vw, 15vh), 7rem);
    line-height: .92;
    letter-spacing: -.02em;
  }

  h1 span,
  h1 em {
    display: block;
  }

  h1 em {
    font-style: italic;
    color: var(--teal);
  }

  .resumen {
    max-width: 40ch;
    margin-top: clamp(16px, 3.4vh, 34px);
    font-size: clamp(1.0625rem, .95rem + .35vw, 1.25rem);
    line-height: 1.5;
    color: var(--soft);
    text-wrap: pretty;
  }

  /* Retrato 4/5 con marco; el placeholder (.ept) aparece si la imagen no carga (.empty). */
  .portrait {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--marco);
    background: var(--wall);
    overflow: hidden;
    box-shadow: 0 18px 44px rgba(0, 0, 0, .13);
  }

  .portrait img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .portrait.empty img {
    display: none;
  }

  .portrait.empty .ept {
    display: flex;
  }

  .ept {
    display: none;
    position: absolute;
    inset: 0;
    z-index: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 11px;
    color: var(--faint);
  }

  .ept .ic {
    width: 34px;
    height: 34px;
    stroke-width: 1.2;
  }

  .ept span {
    font-size: var(--t-micro);
    text-transform: uppercase;
  }

  /* Entrada: solo translate/scale, sin opacity, para no retrasar el LCP. */
  @media (prefers-reduced-motion: no-preference) {
    h1 span,
    h1 em,
    .resumen {
      animation: subir 1s var(--ease) backwards;
    }

    h1 em {
      animation-delay: .06s;
    }

    .resumen {
      animation-delay: .14s;
    }

    .portrait img {
      animation: revelar 1.6s var(--ease) backwards;
    }
  }

  @keyframes subir {
    from {
      translate: 0 22px;
    }
  }

  @keyframes revelar {
    from {
      scale: 1.08;
    }
  }

  @media (max-width: 1024px) {
    .title-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 34vw);
    }

    h1 {
      font-size: clamp(2.875rem, 1rem + 6.4vw, 5rem);
    }
  }

  /* Telefono (<700px): una columna; retrato apaisado bajo el texto. */
  @media (max-width: 699px) {
    .title-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    h1 {
      font-size: clamp(2.875rem, 1rem + 11vw, 4.5rem);
    }

    .portrait {
      aspect-ratio: 4 / 3;
      margin-top: 24px;
      box-shadow: none;
    }

    .portrait img {
      object-position: 50% 66%;
    }
  }
</style>
