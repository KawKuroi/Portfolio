---
/*
  Escena 0 — Portada. Identidad + situacion actual (practica) + indice de actos enlazado |
  retrato. En telefono el orden es texto, retrato apaisado e indice. El retrato degrada con
  onerror a un placeholder (.ept) sin romper la maqueta.
  Copy bilingue por idioma vigente (el nombre propio del H1 no se traduce).
*/
import { ESCENAS } from '../../data/escenas';
import { EMPRESA } from '../../data/experiencia';
import { obtenerIdioma, obtenerTextos } from '../../i18n/ui';

const t = obtenerTextos(obtenerIdioma(Astro.currentLocale));
const actos = ESCENAS.filter((escena) => escena.acto);
---

<section class="scene title" id="portada" data-slate={t.slates.portada}>
  <div class="wrap">
    <div class="title-grid">
      <div class="title-main">
        <p class="kick">{t.portada.kick}</p>
        <h1><span>Kevin Axel</span> <em>Herazo Rolón</em></h1>
        <a class="ahora" href="#experiencia">
          <span class="vivo" aria-hidden="true"></span>
          <span>{t.portada.ahora} <strong>{EMPRESA}</strong></span>
        </a>
        <p class="resumen">{t.portada.resumen}</p>
        <p class="role">{t.portada.rol}</p>
      </div>

      <nav class="acts" aria-label={t.aria.indice}>
        {
          actos.map((escena) => (
            <a href={`#${escena.clave}`}>
              <svg class="ic" aria-hidden="true"><use href={`#${escena.icono}`} /></svg>
              <b>{escena.acto}</b>
              {t.slates[escena.clave]}
            </a>
          ))
        }
      </nav>

      <figure class="portrait">
        <img
          src="/assets/me/retrato.webp"
          width="720"
          height="900"
          alt={t.portada.retratoAlt}
          fetchpriority="high"
          onerror="this.closest('.portrait').classList.add('empty')"
        />
        <span class="ept"><svg class="ic"><use href="#ic-portrait" /></svg><span>{t.portada.retratoPlaceholder}</span></span>
      </figure>
    </div>
  </div>
</section>

<style>
  .title-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(230px, min(31vw, (100dvh - 130px) * .8), 416px);
    grid-template-rows: 1fr auto auto 1fr;
    grid-template-areas:
      '. retrato'
      'texto retrato'
      'indice retrato'
      '. retrato';
    column-gap: clamp(28px, 5vw, 72px);
  }

  .title-main {
    grid-area: texto;
    min-width: 0;
  }

  .kick {
    font-family: var(--mono);
    font-size: var(--t-etiqueta);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--acento-texto);
    margin-bottom: clamp(10px, 2.4vh, 24px);
  }

  h1 {
    font-family: var(--serif);
    font-weight: 400;
    /* El termino en vh evita que el nombre empuje el indice fuera en ventanas bajas. */
    font-size: clamp(3rem, min(1rem + 6vw, 14.5vh), 7rem);
    line-height: .92;
    letter-spacing: -.02em;
  }

  h1 span,
  h1 em {
    display: block;
  }

  h1 em {
    font-style: italic;
    color: var(--teal);
  }

  .ahora {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-height: 44px;
    margin-top: clamp(8px, 2.2vh, 24px);
    line-height: 1.3;
  }

  .ahora strong {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--teal);
    text-underline-offset: 5px;
  }

  .resumen {
    max-width: 48ch;
    margin-top: 4px;
    color: var(--soft);
    text-wrap: pretty;
  }

  .role {
    margin-top: clamp(8px, 1.8vh, 18px);
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--soft);
  }

  .acts {
    grid-area: indice;
    display: flex;
    flex-wrap: wrap;
    column-gap: 20px;
    margin-top: clamp(10px, 2.6vh, 28px);
    padding-top: 6px;
    border-top: 1px solid var(--line2);
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--soft);
  }

  .acts a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 30px;
    transition: color .2s;
  }

  .acts a:hover {
    color: var(--ink);
  }

  .acts .ic {
    width: 14px;
    height: 14px;
    color: var(--teal);
    transition: transform .3s var(--ease);
  }

  .acts a:hover .ic {
    transform: translateY(-2px);
  }

  .acts b {
    color: var(--ink);
    font-weight: 400;
  }

  /* Retrato 4/5 con marco; el placeholder (.ept) aparece si la imagen no carga (.empty). */
  .portrait {
    grid-area: retrato;
    align-self: center;
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--marco);
    background: var(--wall);
    overflow: hidden;
    box-shadow: 0 18px 44px rgba(0, 0, 0, .13);
  }

  .portrait img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .portrait.empty img {
    display: none;
  }

  .portrait.empty .ept {
    display: flex;
  }

  .ept {
    display: none;
    position: absolute;
    inset: 0;
    z-index: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 11px;
    color: var(--faint);
  }

  .ept .ic {
    width: 34px;
    height: 34px;
    stroke-width: 1.2;
  }

  .ept span {
    font-family: var(--mono);
    font-size: var(--t-micro);
    text-transform: uppercase;
  }

  /* Entrada: solo translate/scale, sin opacity, para no retrasar el LCP. */
  @media (prefers-reduced-motion: no-preference) {
    h1 span,
    h1 em,
    .ahora,
    .resumen {
      animation: subir 1s var(--ease) backwards;
    }

    h1 em {
      animation-delay: .06s;
    }

    .ahora {
      animation-delay: .12s;
    }

    .resumen {
      animation-delay: .18s;
    }

    .portrait img {
      animation: revelar 1.6s var(--ease) backwards;
    }
  }

  @keyframes subir {
    from {
      translate: 0 22px;
    }
  }

  @keyframes revelar {
    from {
      scale: 1.08;
    }
  }

  /* Movil/tablet (<=1024px): el indice es una lista con divisores, como la referencia. */
  @media (max-width: 1024px) {
    .title-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 34vw);
    }

    h1 {
      font-size: clamp(2.875rem, 1rem + 6.4vw, 5rem);
    }

    .acts {
      flex-direction: column;
      flex-wrap: nowrap;
      margin-top: 20px;
      padding-top: 0;
      font-family: var(--sans);
      font-size: var(--t-cuerpo);
      letter-spacing: normal;
      text-transform: none;
    }

    .acts a {
      gap: 12px;
      min-height: 46px;
      border-bottom: 1px solid var(--line2);
    }

    .acts .ic {
      width: 17px;
      height: 17px;
    }

    .acts b {
      width: 2em;
      font-family: var(--mono);
      font-size: var(--t-micro);
    }
  }

  /* Telefono (<700px): una columna; retrato apaisado y mas corto, luego el indice. */
  @media (max-width: 699px) {
    .title-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas: 'texto' 'retrato' 'indice';
    }

    h1 {
      font-size: clamp(2.875rem, 1rem + 11vw, 4.5rem);
    }

    .portrait {
      aspect-ratio: 4 / 3;
      margin-top: 22px;
      box-shadow: none;
    }

    .portrait img {
      object-position: 50% 66%;
    }
  }
</style>
