---
/*
  Escena 3 — III · El trabajo.
  - Escritorio: galeria (lista | captura + placa). Capturas y placas se renderizan en build y
    comparten celda: el script solo cambia la clase activa y la altura no salta (PRD 7.2).
  - Movil/tablet: carrusel horizontal de tarjetas con la captura primero (mostrar mas, leer
    menos), deslizamiento nativo con scroll snap.
  Cada proyecto tiene un unico boton: su repositorio en GitHub. Datos en src/data/proyectos.ts.
*/
import { PROYECTOS } from '../../data/proyectos';
import { obtenerIdioma, obtenerTextos } from '../../i18n/ui';

const idioma = obtenerIdioma(Astro.currentLocale);
const t = obtenerTextos(idioma);
const numero = (i: number): string => String(i + 1).padStart(2, '0');
const tags = (lista: readonly string[]): string => lista.join(', ');
---

<section class="scene scene-trabajo" id="trabajo" data-slate={t.slates.trabajo}>
  <div class="wrap">
    <div class="sh" data-entra>
      <span class="act">III</span>
      <h2 set:html={t.trabajo.tituloHtml} />
      <span class="ln"></span>
      <span class="ct">{PROYECTOS.length} {t.trabajo.proyectos}</span>
    </div>

    <div id="twGaleria" class="tw-galeria" data-entra style="--orden:1">
      <div class="twg-list">
        {
          PROYECTOS.map((proyecto, i) => (
            <button
              class:list={['twg-item', { on: i === 0 }]}
              type="button"
              data-i={i}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              <span class="twg-num">{numero(i)}</span>
              <span class="twg-tx">
                <span class="twg-tt">{proyecto.titulo[idioma]}</span>
                <span class="twg-tg">{tags(proyecto.tags)}</span>
              </span>
              <span class="twg-yr">{proyecto.anio[idioma]}</span>
            </button>
          ))
        }
      </div>

      <div class="twg-stage">
        <div class="twg-frame">
          {
            PROYECTOS.map((proyecto, i) => (
              <figure class:list={['ph', { on: i === 0 }]} data-i={i}>
                <img
                  src={proyecto.img}
                  width="1500"
                  height="1000"
                  alt={`${t.trabajo.capturaAlt}${proyecto.titulo[idioma]}`}
                  loading="lazy"
                  decoding="async"
                  onerror="this.closest('.ph').classList.add('empty')"
                />
              </figure>
            ))
          }
        </div>

        <div class="twg-plates">
          {
            PROYECTOS.map((proyecto, i) => (
              <div class:list={['twg-plate', { on: i === 0 }]}>
                <div class="pd">
                  <h3 class="pt">{proyecto.titulo[idioma]}</h3>
                  <p>{proyecto.descripcion[idioma]}</p>
                </div>
                <a class="boton-github" href={proyecto.repo} target="_blank" rel="noopener">
                  <svg class="ic" aria-hidden="true"><use href="#ic-github" /></svg>
                  {t.trabajo.github}
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    {/* Carrusel (movil/tablet <=1024px). DOM dual: la galeria de escritorio queda intacta. */}
    <ul class="tw-carrusel" aria-label={t.aria.carrusel} data-entra>
      {
        PROYECTOS.map((proyecto) => (
          <li class="twc-card">
            <img
              src={proyecto.img}
              width="1500"
              height="1000"
              alt={`${t.trabajo.capturaAlt}${proyecto.titulo[idioma]}`}
              loading="lazy"
              decoding="async"
            />
            <div class="twc-tx">
              <h3>{proyecto.titulo[idioma]}</h3>
              <p class="twc-tg">{tags(proyecto.tags)}</p>
              <p class="twc-desc">{proyecto.descripcion[idioma]}</p>
              <a class="boton-github" href={proyecto.repo} target="_blank" rel="noopener">
                <svg class="ic" aria-hidden="true"><use href="#ic-github" /></svg>
                {t.trabajo.github}
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Galeria de escritorio: marca la obra, la captura y la placa activas.
  const galeria = document.getElementById('twGaleria');
  if (galeria) {
    const items = Array.from(galeria.querySelectorAll<HTMLButtonElement>('.twg-item'));
    const capturas = Array.from(galeria.querySelectorAll<HTMLElement>('.ph'));
    const placas = Array.from(galeria.querySelectorAll<HTMLElement>('.twg-plate'));

    const seleccionar = (i: number): void => {
      items.forEach((boton, j) => {
        boton.classList.toggle('on', j === i);
        boton.setAttribute('aria-pressed', String(j === i));
      });
      capturas.forEach((captura, j) => captura.classList.toggle('on', j === i));
      placas.forEach((placa, j) => placa.classList.toggle('on', j === i));
    };

    items.forEach((boton, i) => boton.addEventListener('click', () => seleccionar(i)));
  }
</script>

<style>
  .scene.scene-trabajo {
    height: auto;
  }

  .tw-galeria {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(26px, 4vw, 58px);
    align-items: center;
  }

  .twg-list {
    display: flex;
    flex-direction: column;
    padding-right: 14px;
  }

  .twg-item {
    position: relative;
    appearance: none;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    width: 100%;
    color: inherit;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: clamp(12px, 1.6vw, 20px);
    align-items: center;
    padding: clamp(6px, 1.6vh, 17px) 0;
    border-top: 1px solid var(--line2);
    transition: translate .35s var(--ease);
  }

  .twg-item:first-child {
    border-top: none;
  }

  .twg-item::before {
    content: '';
    position: absolute;
    left: -12px;
    top: 50%;
    width: 3px;
    height: 58%;
    border-radius: 2px;
    background: var(--teal);
    transform: translate(-2px, -50%) scaleY(0);
    transition: transform .38s var(--ease);
  }

  .twg-item.on::before {
    transform: translate(-2px, -50%) scaleY(1);
  }

  .twg-item:hover {
    translate: 6px 0;
  }

  .twg-item.on {
    translate: 14px 0;
  }

  .twg-num {
    font-family: var(--serif);
    font-size: clamp(20px, 2.5vw, 32px);
    line-height: 1;
    color: var(--faint);
    transition: color .3s;
  }

  .twg-item.on .twg-num {
    color: var(--acento-texto);
  }

  .twg-tx {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .twg-tt {
    font-family: var(--serif);
    font-size: clamp(1.1875rem, .8rem + .75vw, 1.625rem);
    line-height: 1.08;
    letter-spacing: -.01em;
    color: var(--soft);
    transition: color .3s;
  }

  .twg-item:hover .twg-tt,
  .twg-item.on .twg-tt {
    color: var(--ink);
  }

  .twg-tg {
    font-size: var(--t-micro);
    color: var(--faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .twg-item.on .twg-tg {
    color: var(--soft);
  }

  .twg-yr {
    font-family: var(--mono);
    font-size: var(--t-micro);
    color: var(--faint);
    white-space: nowrap;
  }

  .twg-item.on .twg-yr {
    color: var(--acento-texto);
  }

  .twg-stage {
    min-width: 0;
  }

  /* 3:2 completo (sin recortar las capturas); el alto se adapta al viewport. */
  .twg-frame {
    position: relative;
    aspect-ratio: 3 / 2;
    width: min(100%, (100dvh - 300px) * 1.5);
    min-width: 260px;
    border: 1px solid var(--marco);
    background: var(--wall);
    overflow: hidden;
    box-shadow: 0 20px 48px rgba(0, 0, 0, .14);
  }

  .twg-frame .ph {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transform: scale(1.03);
    transition: opacity .55s var(--ease), transform 1.2s var(--ease);
  }

  .twg-frame .ph.on {
    opacity: 1;
    transform: scale(1);
  }

  .twg-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .twg-frame .ph.empty img {
    display: none;
  }

  /* Placas apiladas en la misma celda: la mas alta fija la altura. */
  .twg-plates {
    display: grid;
    margin-top: clamp(10px, 2vh, 20px);
  }

  .twg-plate {
    grid-area: 1 / 1;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    visibility: hidden;
    opacity: 0;
    translate: 0 8px;
    transition: opacity .2s, translate .2s, visibility 0s .2s;
  }

  .twg-plate.on {
    visibility: visible;
    opacity: 1;
    translate: none;
    transition: opacity .45s var(--ease) .1s, translate .45s var(--ease) .1s, visibility 0s;
  }

  .twg-plate .pt {
    font-family: var(--serif);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(1.375rem, 1rem + 1vw, 1.875rem);
    line-height: 1.05;
  }

  .twg-plate .pd p {
    max-width: 62ch;
    margin-top: 6px;
    font-size: var(--t-chico);
    line-height: 1.5;
    color: var(--soft);
    text-wrap: pretty;
  }

  /* Unico boton por proyecto: el repositorio. */
  .boton-github {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    font-size: var(--t-etiqueta);
    font-weight: 600;
    white-space: nowrap;
    transition: background-color .25s, color .25s;
  }

  .boton-github:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .boton-github .ic {
    font-size: 16px;
  }

  /* ════════ Carrusel (movil/tablet) ════════ */
  .tw-carrusel {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .twg-frame .ph,
    .twg-plate {
      transform: none;
      translate: none;
    }
  }

  @media (max-width: 1024px) {
    .scene.scene-trabajo {
      min-height: 0;
    }

    .tw-galeria {
      display: none;
    }

    .tw-carrusel {
      list-style: none;
      display: flex;
      gap: 14px;
      margin: 0 calc(-1 * var(--pad));
      padding: 2px var(--pad) 10px;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--pad);
      scrollbar-width: none;
    }

    .tw-carrusel::-webkit-scrollbar {
      display: none;
    }

    .twc-card {
      flex: 0 0 min(84%, 420px);
      display: flex;
      flex-direction: column;
      scroll-snap-align: start;
      border: 1px solid var(--line);
      background: var(--paper);
    }

    .twc-card img {
      width: 100%;
      height: auto;
      aspect-ratio: 3 / 2;
      object-fit: cover;
      border-bottom: 1px solid var(--line2);
      background: var(--wall);
    }

    .twc-tx {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 14px 16px 16px;
    }

    .twc-tx h3 {
      font-family: var(--serif);
      font-weight: 400;
      font-size: 1.375rem;
      line-height: 1.1;
    }

    .twc-tg {
      font-size: var(--t-micro);
      color: var(--faint);
    }

    .twc-desc {
      font-size: var(--t-chico);
      line-height: 1.45;
      color: var(--soft);
    }

    .twc-tx .boton-github {
      align-self: flex-start;
      min-height: 44px;
      margin-top: auto;
    }
  }
</style>
