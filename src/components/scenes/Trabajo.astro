---
/*
  Escena 3 — III · El trabajo. Disposicion fija: Galeria (la unica). Capturas y placas se
  renderizan en build desde PROYECTOS y comparten celda: el script solo cambia la clase activa,
  no envia datos al cliente y la altura no salta al cambiar de obra (PRD 7.2).
*/
import { PROYECTOS } from '../../data/proyectos';
import { obtenerIdioma, obtenerTextos } from '../../i18n/ui';

const idioma = obtenerIdioma(Astro.currentLocale);
const t = obtenerTextos(idioma);
const numero = (i: number): string => String(i + 1).padStart(2, '0');
---

<section class="scene scene-trabajo" id="trabajo" data-slate={t.slates.trabajo}>
  <div class="wrap">
    <div class="sh" data-entra>
      <span class="act">III</span>
      <h2 set:html={t.trabajo.tituloHtml}></h2>
      <span class="ln"></span>
      <span class="ct">{PROYECTOS.length} {t.trabajo.proyectos}</span>
    </div>

    <div id="twGaleria" class="tw-galeria" data-entra style="--orden:1">
      <div class="twg-list">
        {
          PROYECTOS.map((proyecto, i) => (
            <button
              class:list={['twg-item', { on: i === 0 }]}
              type="button"
              data-i={i}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              <span class="twg-num">{numero(i)}</span>
              <span class="twg-tx">
                <span class="twg-tt">{proyecto.titulo[idioma]}</span>
                <span class="twg-tg">{proyecto.tags[idioma]}</span>
              </span>
              <span class="twg-yr">{proyecto.anio[idioma]}</span>
            </button>
          ))
        }
        <div class="twg-hint">{t.trabajo.pista}</div>
      </div>

      <div class="twg-stage">
        <div class="twg-frame">
          {
            PROYECTOS.map((proyecto, i) => (
              <figure class:list={['ph', { on: i === 0 }]} data-i={i}>
                <img
                  src={proyecto.img}
                  alt={`${t.trabajo.capturaAlt}${proyecto.titulo[idioma]}`}
                  loading="lazy"
                  onerror="this.closest('.ph').classList.add('empty')"
                />
              </figure>
            ))
          }
        </div>

        <div class="twg-plates">
          {
            PROYECTOS.map((proyecto, i) => (
              <div class:list={['twg-plate', { on: i === 0 }]}>
                <h3 class="pt">{proyecto.titulo[idioma]}</h3>
                <p class="pd">{proyecto.descripcion[idioma]}</p>
                <div class="pm">
                  <span class="st">{proyecto.estado[idioma]}</span>
                  {proyecto.demo && (
                    <a class="go demo" href={proyecto.demo} target="_blank" rel="noopener">
                      <span class="vivo" aria-hidden="true" />
                      {t.trabajo.verEnLinea}
                    </a>
                  )}
                  <a class="go" href={proyecto.repo} target="_blank" rel="noopener">
                    {t.trabajo.repoFlecha}
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    {/* Acordeon indice (movil/tablet <=1024px): reemplaza la galeria maestro-detalle.
        DOM dual: la galeria de escritorio queda intacta; esto se muestra solo en <=1024px. */}
    <div class="tw-acc" data-entra>
      {
        PROYECTOS.map((proyecto, i) => (
          <div class:list={['twa-item', { open: i === 0 }]}>
            <button
              class="twa-head"
              type="button"
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`twa-panel-${i}`}
            >
              <span class="twa-no">{numero(i)}</span>
              <span class="twa-tx">
                <span class="twa-tt">{proyecto.titulo[idioma]}</span>
                <span class="twa-tg">{proyecto.tags[idioma]}</span>
              </span>
              <span class="twa-yr">{proyecto.anio[idioma]}</span>
              <svg class="ic twa-chev" aria-hidden="true"><use href="#ic-chevron" /></svg>
            </button>
            <div class="twa-panel" id={`twa-panel-${i}`}>
              <div class="twa-inner">
                <figure class="twa-frame">
                  <img
                    src={proyecto.img}
                    alt={`${t.trabajo.capturaAlt}${proyecto.titulo[idioma]}`}
                    loading="lazy"
                    onerror="this.closest('.twa-frame').classList.add('empty')"
                  />
                </figure>
                <div class="twa-txt">
                  <p class="twa-desc">{proyecto.descripcion[idioma]}</p>
                  <div class="twa-meta">
                    <span class="st">{proyecto.estado[idioma]}</span>
                    {proyecto.demo && (
                      <a class="go demo" href={proyecto.demo} target="_blank" rel="noopener">
                        <span class="vivo" aria-hidden="true" />{t.trabajo.verEnLinea}
                      </a>
                    )}
                    <a class="go" href={proyecto.repo} target="_blank" rel="noopener">{t.trabajo.repoFlecha}</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { anclar } from '../../scripts/anclaje';

  // Galeria de escritorio: marca la obra, la captura y la placa activas.
  const galeria = document.getElementById('twGaleria');
  if (galeria) {
    const items = Array.from(galeria.querySelectorAll<HTMLButtonElement>('.twg-item'));
    const capturas = Array.from(galeria.querySelectorAll<HTMLElement>('.ph'));
    const placas = Array.from(galeria.querySelectorAll<HTMLElement>('.twg-plate'));

    const seleccionar = (i: number): void => {
      items.forEach((boton, j) => {
        boton.classList.toggle('on', j === i);
        boton.setAttribute('aria-pressed', String(j === i));
      });
      capturas.forEach((captura, j) => captura.classList.toggle('on', j === i));
      placas.forEach((placa, j) => placa.classList.toggle('on', j === i));
    };

    items.forEach((boton, i) => boton.addEventListener('click', () => seleccionar(i)));
  }

  // Acordeon indice (movil/tablet <=1024px). Un solo panel abierto a la vez: al abrir uno, los
  // demas se colapsan; pulsar el abierto lo cierra. La cabecera pulsada se queda bajo el dedo
  // aunque se colapse un panel que estaba encima.
  const itemsTrabajo = Array.from(document.querySelectorAll<HTMLElement>('.tw-acc .twa-item'));
  itemsTrabajo.forEach((item) => {
    const cabecera = item.querySelector<HTMLButtonElement>('.twa-head');
    cabecera?.addEventListener('click', () => {
      const yaAbierto = item.classList.contains('open');
      anclar(cabecera);
      itemsTrabajo.forEach((otro) => {
        const abrir = otro === item && !yaAbierto;
        otro.classList.toggle('open', abrir);
        otro.querySelector('.twa-head')?.setAttribute('aria-expanded', String(abrir));
      });
    });
  });
</script>

<style>
  /* La escena crece con su contenido (PRD 7.2). */
  .scene.scene-trabajo {
    height: auto;
  }

  .tw-galeria {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(26px, 4vw, 58px);
    align-items: center;
  }

  .twg-list {
    padding-right: 14px;
    display: flex;
    flex-direction: column;
  }

  .twg-item {
    position: relative;
    appearance: none;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    width: 100%;
    color: inherit;
    font-family: inherit;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: clamp(12px, 1.6vw, 20px);
    align-items: center;
    padding: clamp(6px, 1.6vh, 17px) 0;
    border-top: 1px solid var(--line2);
    transition: translate .35s var(--ease);
  }

  .twg-item:first-child {
    border-top: none;
  }

  .twg-item::before {
    content: "";
    position: absolute;
    left: -12px;
    top: 50%;
    width: 3px;
    height: 58%;
    border-radius: 2px;
    background: var(--teal);
    transform: translate(-2px, -50%) scaleY(0);
    transform-origin: center;
    transition: transform .38s var(--ease);
  }

  .twg-item.on::before {
    transform: translate(-2px, -50%) scaleY(1);
  }

  .twg-item:hover {
    translate: 6px 0;
  }

  .twg-item.on {
    translate: 14px 0;
  }

  .twg-num {
    font-family: var(--serif);
    font-size: clamp(20px, 2.5vw, 32px);
    color: var(--faint);
    line-height: 1;
    transition: color .3s;
  }

  .twg-item:hover .twg-num {
    color: var(--soft);
  }

  .twg-item.on .twg-num {
    color: var(--acento-texto);
  }

  .twg-tx {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .twg-tt {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(1.1875rem, .8rem + .75vw, 1.625rem);
    line-height: 1.08;
    letter-spacing: -.01em;
    color: var(--soft);
    transition: color .3s;
  }

  .twg-item:hover .twg-tt,
  .twg-item.on .twg-tt {
    color: var(--ink);
  }

  .twg-tg {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: .02em;
    color: var(--faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color .3s;
  }

  .twg-item.on .twg-tg {
    color: var(--soft);
  }

  .twg-yr {
    font-family: var(--mono);
    font-size: var(--t-micro);
    color: var(--faint);
    white-space: nowrap;
    align-self: center;
    transition: color .3s;
  }

  .twg-item.on .twg-yr {
    color: var(--acento-texto);
  }

  .twg-hint {
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: .05em;
    color: var(--faint);
    margin-top: 14px;
    padding-top: 13px;
    border-top: 1px solid var(--line2);
  }

  .twg-stage {
    min-width: 0;
  }

  .twg-frame {
    position: relative;
    /* El alto sale del viewport: placa y enlaces deben caber sin scroll. */
    height: clamp(120px, min(100dvh - 370px, 30vw), 440px);
    border: 1px solid var(--marco);
    background: var(--wall);
    overflow: hidden;
    box-shadow: 0 20px 48px rgba(0, 0, 0, .14);
  }

  .twg-frame .ph {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transform: scale(1.05);
    transition: opacity .55s var(--ease), transform 1.2s var(--ease);
  }

  .twg-frame .ph.on {
    opacity: 1;
    transform: scale(1);
  }

  .twg-frame .ph img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  .twg-frame .ph.empty {
    background: repeating-linear-gradient(
      135deg,
      transparent 0 9px,
      color-mix(in srgb, var(--ink) 5%, transparent) 9px 10px
    );
  }

  .twg-frame .ph.empty img {
    display: none;
  }

  /* Placas apiladas en la misma celda: la mas alta fija la altura. */
  .twg-plates {
    display: grid;
    margin-top: clamp(10px, 2vh, 20px);
  }

  .twg-plate {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    visibility: hidden;
    opacity: 0;
    translate: 0 8px;
    transition: opacity .2s, translate .2s, visibility 0s .2s;
  }

  .twg-plate.on {
    visibility: visible;
    opacity: 1;
    translate: none;
    transition: opacity .45s var(--ease) .1s, translate .45s var(--ease) .1s, visibility 0s;
  }

  .twg-plate .pt {
    font-family: var(--serif);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(1.375rem, 1rem + 1vw, 1.875rem);
    line-height: 1.05;
  }

  .twg-plate .pd {
    max-width: 66ch;
    margin-top: 6px;
    font-size: var(--t-chico);
    line-height: 1.5;
    color: var(--soft);
    text-wrap: pretty;
  }

  .twg-plate .pm {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 clamp(14px, 2vw, 22px);
    margin-top: 4px;
  }

  .twg-plate .pm .st {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.1875rem;
  }

  .twg-plate .pm .go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 34px;
    font-family: var(--mono);
    font-size: var(--t-micro);
    text-transform: uppercase;
    color: var(--acento-texto);
    text-decoration: underline;
    text-underline-offset: 5px;
    transition: opacity .2s;
  }

  .twg-plate .pm .go:hover {
    opacity: .7;
  }

  /* ════════ Acordeon indice (movil/tablet) ════════
     DOM dual: convive con la galeria de escritorio. Oculto por defecto; se
     muestra solo en <=1024px (ver la media query de abajo). */
  .tw-acc {
    display: none;
    border-top: 1px solid var(--line2);
  }

  .twa-item {
    border-bottom: 1px solid var(--line2);
  }

  .twa-head {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    gap: 13px;
    align-items: center;
    width: 100%;
    appearance: none;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    color: inherit;
    font-family: inherit;
    padding: 16px 0;
  }

  .twa-no {
    font-family: var(--serif);
    font-size: 20px;
    line-height: 1;
    color: var(--faint);
    transition: color .3s;
  }

  .twa-item.open .twa-no {
    color: var(--acento-texto);
  }

  .twa-tx {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .twa-tt {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.3125rem;
    line-height: 1.12;
    letter-spacing: -.01em;
  }

  .twa-tg {
    font-family: var(--mono);
    font-size: var(--t-micro);
    color: var(--faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .twa-yr {
    font-family: var(--mono);
    font-size: var(--t-micro);
    color: var(--faint);
    white-space: nowrap;
  }

  .twa-chev {
    width: 16px;
    height: 16px;
    color: var(--soft);
    transition: transform .35s var(--ease), color .3s;
  }

  .twa-item.open .twa-chev {
    transform: rotate(180deg);
    color: var(--teal);
  }

  /* Panel plegable: anima la altura con grid-template-rows 0fr -> 1fr. */
  .twa-panel {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    /* Cerrado: sus enlaces salen del orden de tabulacion. */
    visibility: hidden;
    transition: grid-template-rows .4s var(--ease), visibility .4s;
  }

  .twa-item.open .twa-panel {
    grid-template-rows: 1fr;
    visibility: visible;
  }

  .twa-panel > * {
    min-height: 0; /* permite que el contenido colapse a 0 al cerrar */
    overflow: hidden;
  }

  .twa-txt {
    padding-bottom: 10px;
  }

  .twa-frame {
    position: relative;
    aspect-ratio: 3 / 2;
    border: 1px solid var(--marco);
    overflow: hidden;
    background: var(--wall);
    margin-bottom: 13px;
  }

  .twa-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  .twa-frame.empty {
    background: repeating-linear-gradient(
      135deg,
      transparent 0 9px,
      color-mix(in srgb, var(--ink) 5%, transparent) 9px 10px
    );
  }

  .twa-frame.empty img {
    display: none;
  }

  .twa-desc {
    font-size: var(--t-chico);
    color: var(--soft);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .twa-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 18px;
    margin-top: 6px;
  }

  .twa-meta .st {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.1875rem;
    color: var(--ink);
  }

  .twa-meta .go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-family: var(--mono);
    font-size: var(--t-micro);
    text-transform: uppercase;
    color: var(--acento-texto);
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  /* Reglas separadas a proposito: Lightning CSS (minificador de Vite 8) fusiona `translate`
     dentro de `transform` cuando conviven en una regla y se pierde el reset de `translate`.
     La captura solo usa `transform` (scale) y la placa solo `translate`. */
  @media (prefers-reduced-motion: reduce) {
    .twg-frame .ph {
      transform: none;
    }

    .twg-plate {
      translate: none;
    }
  }

  @media (max-width: 1024px) {
    /* En flujo movil/tablet la escena mide su contenido y se cambia la galeria
       maestro-detalle por el acordeon indice. */
    .scene.scene-trabajo {
      min-height: 0;
    }

    .twa-tg {
      white-space: normal;
    }

    .tw-galeria {
      display: none;
    }

    .tw-acc {
      display: block;
    }
  }

  /* Tablet (700-1024px): el panel abierto reparte imagen | texto en dos columnas. */
  @media (min-width: 700px) and (max-width: 1024px) {
    .twa-inner {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 24px;
      align-items: start;
    }

    .twa-frame {
      margin-bottom: 0;
    }
  }
</style>
