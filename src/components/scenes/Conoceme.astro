---
/*
  Escena 5 — V · Conoceme. Persiana (acordeon) con 20 piezas favoritas.
  - Escritorio (>=1025px): persiana horizontal estirada con autoplay y boton de pausa.
  - Movil/tablet (<=1024px): persiana vertical precedida por chips de categoria. Arranca en
    Cine (5 piezas) para no interponer 20 filas antes del contacto; "Todo" las muestra todas.
  El comportamiento (filtro incluido) vive en src/scripts/persiana.ts.
*/
import Persiana from '../Persiana.astro';
import { type Categoria } from '../../data/favoritos';
import { obtenerIdioma, obtenerTextos } from '../../i18n/ui';

const t = obtenerTextos(obtenerIdioma(Astro.currentLocale));

// Chips de filtro (solo movil/tablet). La clave (data-f) se mantiene en espanol para casar con
// data-cat de la persiana; solo se traduce la etiqueta visible. Mismo icono por categoria.
const CATEGORIAS: Categoria[] = ['Cine', 'Juegos', 'Libros', 'Música'];
const INICIAL: Categoria = 'Cine';
const ICONO_CAT: Record<Categoria, string> = {
  Cine: 'ic-film',
  Juegos: 'ic-game',
  Libros: 'ic-book',
  Música: 'ic-music',
};
---

<section class="scene act-persiana" id="conoceme" data-slate={t.slates.conoceme}>
  <div class="wrap">
    <div class="sh" data-entra>
      <span class="act">V</span>
      <h2 set:html={t.conoceme.tituloHtml} />
      <span class="ln"></span>
      <span class="ct">{t.conoceme.sub}</span>
    </div>

    {/* Filtro por categoria: visible solo en movil/tablet (<=1024px). */}
    <div class="cf-filter" role="group" aria-label={t.aria.filtro}>
      {
        CATEGORIAS.map((c) => (
          <button
            class:list={['cf-chip', { on: c === INICIAL }]}
            type="button"
            data-f={c}
            aria-pressed={c === INICIAL}
          >
            <svg class="ic" aria-hidden="true"><use href={`#${ICONO_CAT[c]}`} /></svg>
            {t.categorias[c]}
          </button>
        ))
      }
      <button class="cf-chip" type="button" data-f="all" aria-pressed="false">{t.conoceme.todo}</button>
    </div>

    <Persiana filtro={INICIAL} />

    <div class="pie">
      <p class="note nota-puntero">{t.conoceme.nota}</p>
      <p class="note nota-tactil">{t.conoceme.notaTactil}</p>
      <button
        class="pausa"
        type="button"
        data-pausa
        data-pausar={t.conoceme.pausar}
        data-reproducir={t.conoceme.reproducir}
      >
        <svg class="ic" aria-hidden="true"><use href="#ic-pause" /></svg>
        <span>{t.conoceme.pausar}</span>
      </button>
    </div>

    <noscript>
      <style is:inline>
        .persiana .pslat { display: block !important; }
        .cf-filter, .pausa { display: none !important; }
      </style>
    </noscript>
  </div>
</section>

<style>
  /* La escena estira su contenido; la persiana ocupa el alto disponible. */
  .scene.act-persiana {
    justify-content: stretch;
    height: 100vh;
    height: 100dvh;
  }

  .act-persiana .wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    gap: clamp(10px, 2vh, 20px);
  }

  .act-persiana .sh {
    margin-bottom: 0;
    flex: 0 0 auto;
  }

  .pie {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
  }

  .note {
    max-width: 80ch;
    font-family: var(--mono);
    font-size: var(--t-micro);
    line-height: 1.6;
    color: var(--soft);
  }

  .nota-tactil {
    display: none;
  }

  .pausa {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 34px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    color: var(--soft);
    cursor: pointer;
    font-family: var(--mono);
    font-size: var(--t-micro);
    transition: color .25s, border-color .25s;
  }

  .pausa:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  /* ── Chips de filtro: ocultos en escritorio ── */
  .cf-filter {
    display: none;
  }

  .cf-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 14px;
    appearance: none;
    cursor: pointer;
    font-family: var(--mono);
    font-size: var(--t-micro);
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    color: var(--soft);
    transition: background-color .25s, color .25s, border-color .25s;
  }

  .cf-chip .ic {
    width: 14px;
    height: 14px;
    color: var(--teal);
  }

  .cf-chip.on {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .cf-chip.on .ic {
    color: var(--paper);
  }

  @media (max-width: 1024px) {
    .scene.act-persiana {
      height: auto;
    }

    .act-persiana .wrap {
      display: block;
    }

    .act-persiana .sh {
      margin-bottom: 18px;
    }

    /* Se envuelven en vez de desplazarse de lado: ninguna categoria queda escondida. */
    .cf-filter {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 16px;
    }

    .pie {
      margin-top: 14px;
    }

    .nota-puntero,
    .pausa {
      display: none;
    }

    .nota-tactil {
      display: block;
    }
  }
</style>
