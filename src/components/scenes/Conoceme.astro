---
/*
  Escena 5 — V · Conoceme. Persiana con 20 piezas favoritas.
  - Escritorio (>=1025px): acordeon horizontal con autoplay y boton de pausa.
  - Movil/tablet (<=1024px): carrusel de caratulas que se desliza de lado (mostrar mas, leer
    menos). El comportamiento vive en src/scripts/persiana.ts.
*/
import Persiana from '../Persiana.astro';
import { obtenerIdioma, obtenerTextos } from '../../i18n/ui';

const t = obtenerTextos(obtenerIdioma(Astro.currentLocale));
---

<section class="scene act-persiana" id="conoceme" data-slate={t.slates.conoceme}>
  <div class="wrap">
    <div class="sh" data-entra>
      <span class="act">V</span>
      <h2 set:html={t.conoceme.tituloHtml} />
      <span class="ln"></span>
      <span class="ct">{t.conoceme.sub}</span>
    </div>

    <Persiana />

    <div class="pie">
      <p class="note nota-puntero">{t.conoceme.nota}</p>
      <p class="note nota-tactil">{t.conoceme.notaTactil}</p>
      <button
        class="pausa"
        type="button"
        data-pausa
        data-pausar={t.conoceme.pausar}
        data-reproducir={t.conoceme.reproducir}
      >
        <svg class="ic" aria-hidden="true"><use href="#ic-pause" /></svg>
        <span>{t.conoceme.pausar}</span>
      </button>
    </div>
  </div>
</section>

<style>
  /* La escena estira su contenido; la persiana ocupa el alto disponible. */
  .scene.act-persiana {
    justify-content: stretch;
    height: 100vh;
    height: 100dvh;
  }

  .act-persiana .wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    gap: clamp(10px, 2vh, 20px);
  }

  .act-persiana .sh {
    margin-bottom: 0;
    flex: 0 0 auto;
  }

  .pie {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
  }

  .note {
    max-width: 80ch;
    font-size: var(--t-etiqueta);
    line-height: 1.6;
    color: var(--soft);
  }

  .nota-tactil {
    display: none;
  }

  .pausa {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 34px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    color: var(--soft);
    cursor: pointer;
    font-size: var(--t-micro);
    font-weight: 600;
    transition: color .25s, border-color .25s;
  }

  .pausa:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  @media (max-width: 1024px) {
    .scene.act-persiana {
      height: auto;
    }

    .act-persiana .wrap {
      display: block;
    }

    .act-persiana .sh {
      margin-bottom: 18px;
    }

    .pie {
      margin-top: 12px;
    }

    .nota-puntero,
    .pausa {
      display: none;
    }

    .nota-tactil {
      display: block;
    }
  }
</style>
