---
/*
  Escena 2 — II · IA aplicada. Cuatro practicas, cada una con su evidencia cuando es publica,
  y el flujo de trabajo con agentes. Datos en src/data/experiencia.ts.
*/
import { HERRAMIENTAS_IA, PRACTICAS_IA } from '../../data/experiencia';
import { obtenerIdioma, obtenerTextos } from '../../i18n/ui';

const idioma = obtenerIdioma(Astro.currentLocale);
const t = obtenerTextos(idioma);
---

<section class="scene" id="ia" data-slate={t.slates.ia}>
  <div class="wrap">
    <div class="sh" data-entra>
      <span class="act">II</span>
      <h2 set:html={t.ia.tituloHtml} />
      <span class="ln"></span>
      <span class="ct">{t.ia.sub}</span>
    </div>

    <p class="ia-intro" data-entra style="--orden:1">{t.ia.intro}</p>

    <ul class="practicas">
      {
        PRACTICAS_IA.map((practica, i) => (
          <li data-entra style={`--orden:${i + 2}`}>
            <svg class="ic" aria-hidden="true">
              <use href={`#${practica.icono}`} />
            </svg>
            <h3>{practica.titulo[idioma]}</h3>
            <p>{practica.texto[idioma]}</p>
            {practica.evidencia && (
              <a class="evidencia" href={practica.evidencia.url} target="_blank" rel="noopener">
                {practica.evidencia.nombre} <span aria-hidden="true">↗</span>
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <div class="flujo" data-entra style="--orden:6">
      <p class="eh">{t.ia.flujoTitulo}</p>
      <ol>
        {t.ia.flujo.map((paso, i) => <li style={`--paso:${i}`}>{paso}</li>)}
      </ol>
    </div>

    <ul class="chips" aria-label={t.ia.herramientas}>
      {HERRAMIENTAS_IA.map((herramienta) => <li>{herramienta}</li>)}
    </ul>
  </div>
</section>

<style>
  .ia-intro {
    max-width: 56ch;
    font-family: var(--serif);
    font-size: clamp(1.25rem, 1rem + .8vw, 1.75rem);
    line-height: 1.25;
    text-wrap: pretty;
  }

  .practicas {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(14px, 3.4vh, 38px);
    border-block: 1px solid var(--line);
  }

  .practicas > li {
    display: flex;
    flex-direction: column;
    padding: clamp(12px, 2.4vh, 24px) clamp(12px, 1.6vw, 22px);
    border-left: 1px solid var(--line2);
  }

  .practicas > li:first-child {
    border-left: none;
    padding-left: 0;
  }

  .practicas .ic {
    font-size: 24px;
    color: var(--teal);
  }

  .practicas h3 {
    margin-top: 10px;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.25rem, 1rem + .7vw, 1.625rem);
    line-height: 1.1;
  }

  .practicas p {
    margin-top: 7px;
    font-size: var(--t-chico);
    line-height: 1.5;
    color: var(--soft);
    text-wrap: pretty;
  }

  .evidencia {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 6px;
    min-height: 36px;
    margin-top: auto;
    padding-top: 6px;
    font-family: var(--mono);
    font-size: var(--t-micro);
    color: var(--acento-texto);
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .flujo {
    margin-top: clamp(12px, 2.6vh, 28px);
  }

  .flujo ol {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .flujo li {
    position: relative;
    padding: 16px 10px 0 0;
    font-size: var(--t-chico);
    line-height: 1.3;
  }

  /* Tramo de linea + nodo de cada paso. */
  .flujo li::before {
    content: '';
    position: absolute;
    top: 5px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--teal);
    transform-origin: left;
  }

  .flujo li::after {
    content: '';
    position: absolute;
    top: 1px;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--teal);
  }

  .flujo li:last-child {
    font-weight: 600;
  }

  .flujo li:last-child::before {
    display: none;
  }

  .chips {
    margin-top: clamp(12px, 2.4vh, 24px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .flujo.entro li::before {
      animation: trazo .4s linear backwards;
      animation-delay: calc(.5s + var(--paso) * .32s);
    }

    .flujo.entro li::after {
      animation: nodo .35s var(--ease) backwards;
      animation-delay: calc(.4s + var(--paso) * .32s);
    }
  }

  @keyframes trazo {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes nodo {
    from {
      transform: scale(0);
    }
  }

  @media (max-width: 1024px) {
    .practicas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-block: none;
    }

    .practicas > li,
    .practicas > li:first-child {
      padding: 18px 18px 14px 0;
      border-left: none;
      border-top: 1px solid var(--line2);
    }

    .evidencia {
      min-height: 44px;
    }
  }

  @media (max-width: 599px) {
    /* Telefono: icono a la izquierda y texto al lado. */
    .practicas {
      grid-template-columns: minmax(0, 1fr);
    }

    .practicas > li,
    .practicas > li:first-child {
      display: grid;
      grid-template-columns: 36px minmax(0, 1fr);
      padding: 16px 0;
    }

    .practicas > li > :not(.ic) {
      grid-column: 2;
    }

    .practicas h3 {
      grid-row: 1;
      margin-top: 0;
    }

    .flujo ol {
      grid-template-columns: minmax(0, 1fr);
    }

    .flujo li {
      padding: 0 0 14px 24px;
    }

    .flujo li::before {
      top: 5px;
      bottom: -5px;
      left: 4px;
      right: auto;
      width: 1px;
      height: auto;
      transform-origin: top;
    }

    .flujo li::after {
      top: 4px;
    }

    @media (prefers-reduced-motion: no-preference) {
      .flujo.entro li::before {
        animation-name: trazoVertical;
      }
    }
  }

  @keyframes trazoVertical {
    from {
      transform: scaleY(0);
    }
  }
</style>
