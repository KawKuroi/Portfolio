---
/*
  Escena 2 — II · IA aplicada. Cuatro capacidades con su repositorio cuando es publico, el flujo
  de trabajo con agentes y las herramientas. Datos en src/data/experiencia.ts.
*/
import { HERRAMIENTAS_IA, PRACTICAS_IA } from '../../data/experiencia';
import { obtenerIdioma, obtenerTextos } from '../../i18n/ui';

const idioma = obtenerIdioma(Astro.currentLocale);
const t = obtenerTextos(idioma);
---

<section class="scene" id="ia" data-slate={t.slates.ia}>
  <div class="wrap">
    <div class="sh" data-entra>
      <span class="act">II</span>
      <h2 set:html={t.ia.tituloHtml} />
      <span class="ln"></span>
      <span class="ct">{t.ia.sub}</span>
    </div>

    <p class="ia-intro" data-entra style="--orden:1">{t.ia.intro}</p>

    <ul class="practicas">
      {
        PRACTICAS_IA.map((practica, i) => (
          <li data-entra style={`--orden:${i + 2}`}>
            <svg class="ic" aria-hidden="true">
              <use href={`#${practica.icono}`} />
            </svg>
            <h3>{practica.titulo[idioma]}</h3>
            <p>{practica.texto[idioma]}</p>
            {practica.github && (
              <a class="repo" href={practica.github.url} target="_blank" rel="noopener">
                <svg class="ic" aria-hidden="true"><use href="#ic-github" /></svg>
                {practica.github.nombre}
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <div class="pie" data-entra style="--orden:6">
      <div class="flujo">
        <p class="eh">{t.ia.flujoTitulo}</p>
        <ol>
          {t.ia.flujo.map((paso, i) => <li style={`--paso:${i}`}>{paso}</li>)}
        </ol>
      </div>
      <ul class="chips" aria-label={t.ia.herramientas}>
        {HERRAMIENTAS_IA.map((herramienta) => <li>{herramienta}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .ia-intro {
    max-width: 60ch;
    font-family: var(--serif);
    font-size: clamp(1.25rem, 1rem + .8vw, 1.75rem);
    line-height: 1.25;
    text-wrap: pretty;
  }

  .practicas {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(14px, 3vh, 34px);
    border-block: 1px solid var(--line);
  }

  .practicas > li {
    display: flex;
    flex-direction: column;
    padding: clamp(12px, 2.2vh, 22px) clamp(12px, 1.6vw, 22px);
    border-left: 1px solid var(--line2);
  }

  .practicas > li:first-child {
    border-left: none;
    padding-left: 0;
  }

  .practicas > li > .ic {
    font-size: 24px;
    color: var(--teal);
  }

  .practicas h3 {
    margin-top: 10px;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.25rem, 1rem + .7vw, 1.625rem);
    line-height: 1.1;
  }

  .practicas p {
    margin-top: 6px;
    font-size: var(--t-chico);
    line-height: 1.5;
    color: var(--soft);
    text-wrap: pretty;
  }

  .repo {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 7px;
    min-height: 34px;
    margin-top: auto;
    padding-top: 8px;
    font-size: var(--t-micro);
    font-weight: 600;
    color: var(--acento-texto);
  }

  .repo:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .pie {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px 32px;
    margin-top: clamp(12px, 2.6vh, 28px);
  }

  .flujo {
    flex: 1 1 520px;
  }

  .flujo ol {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .flujo li {
    position: relative;
    padding: 16px 10px 0 0;
    font-size: var(--t-chico);
    line-height: 1.3;
  }

  /* Tramo de linea + nodo de cada paso. */
  .flujo li::before {
    content: '';
    position: absolute;
    top: 5px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--teal);
    transform-origin: left;
  }

  .flujo li::after {
    content: '';
    position: absolute;
    top: 1px;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--teal);
  }

  .flujo li:last-child {
    font-weight: 600;
  }

  .flujo li:last-child::before {
    display: none;
  }

  .pie .chips {
    flex: 0 1 auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pie.entro .flujo li::before {
      animation: trazo .4s linear backwards;
      animation-delay: calc(.5s + var(--paso) * .32s);
    }

    .pie.entro .flujo li::after {
      animation: nodo .35s var(--ease) backwards;
      animation-delay: calc(.4s + var(--paso) * .32s);
    }
  }

  @keyframes trazo {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes nodo {
    from {
      transform: scale(0);
    }
  }

  @media (max-width: 1024px) {
    .practicas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-block: none;
    }

    .practicas > li,
    .practicas > li:first-child {
      padding: 18px 18px 14px 0;
      border-left: none;
      border-top: 1px solid var(--line2);
    }

    .repo {
      min-height: 44px;
    }
  }

  /* Telefono: tarjetas de icono y titulo en dos columnas (la intro ya lo cuenta); el flujo
     pasa a pasos en pastilla. */
  @media (max-width: 599px) {
    .practicas {
      gap: 1px;
      background: var(--line2);
      border: 1px solid var(--line2);
    }

    .practicas > li,
    .practicas > li:first-child {
      padding: 14px 12px 6px;
      border: none;
      background: var(--paper);
    }

    .practicas > li > .ic {
      font-size: 22px;
    }

    .practicas h3 {
      margin-top: 8px;
      font-size: 1.1875rem;
    }

    .practicas p {
      display: none;
    }

    .flujo ol {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      counter-reset: paso;
    }

    .flujo li {
      padding: 6px 12px;
      border: 1px solid var(--line);
      border-radius: 999px;
      font-size: var(--t-etiqueta);
      counter-increment: paso;
    }

    .flujo li::before,
    .flujo li::after {
      display: none;
    }

    .flujo li:last-child {
      border-color: var(--teal);
    }
  }
</style>
