---
/*
  Escena 1 — I · La experiencia. Practica empresarial actual: rol y herramientas a la
  izquierda, proyecto principal a la derecha. Datos en src/data/experiencia.ts (leer alli
  la nota de confidencialidad antes de editar).
*/
import { EMPRESA, APORTES_PRACTICA, HERRAMIENTAS_PRACTICA } from '../../data/experiencia';
import { obtenerIdioma, obtenerTextos } from '../../i18n/ui';

const idioma = obtenerIdioma(Astro.currentLocale);
const t = obtenerTextos(idioma);
---

<section class="scene" id="experiencia" data-slate={t.slates.experiencia}>
  <div class="wrap">
    <div class="sh" data-entra>
      <span class="act">I</span>
      <h2 set:html={t.experiencia.tituloHtml} />
      <span class="ln"></span>
      <span class="ct">{t.experiencia.sub}</span>
    </div>

    <div class="exp">
      <div class="exp-rol" data-entra style="--orden:1">
        <p class="exp-fecha"><span class="vivo" aria-hidden="true"></span>{t.experiencia.periodo}</p>
        <h3 class="exp-empresa">{EMPRESA}</h3>
        <p class="exp-cargo">{t.experiencia.cargo}</p>
        <p class="exp-resumen">{t.experiencia.resumen}</p>
        <ul class="chips" aria-label={t.experiencia.herramientas}>
          {HERRAMIENTAS_PRACTICA.map((herramienta) => <li>{herramienta}</li>)}
        </ul>
      </div>

      <div class="exp-proyecto" data-entra style="--orden:2">
        <p class="eh">{t.experiencia.proyectoEtiqueta}</p>
        <h3 class="exp-nombre">{t.experiencia.proyecto}</h3>
        <p class="exp-desc">{t.experiencia.descripcion}</p>
        <ul class="aportes">
          {
            APORTES_PRACTICA.map((aporte) => (
              <li>
                <h4>
                  <svg class="ic" aria-hidden="true"><use href={`#${aporte.icono}`} /></svg>
                  {aporte.titulo[idioma]}
                </h4>
                <p>{aporte.texto[idioma]}</p>
              </li>
            ))
          }
        </ul>
        <p class="exp-nota">{t.experiencia.confidencial}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .exp {
    display: grid;
    grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }

  .exp-fecha {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--acento-texto);
  }

  .exp-empresa {
    margin-top: 12px;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 1.2rem + 2.2vw, 3.25rem);
    line-height: .98;
    letter-spacing: -.01em;
  }

  .exp-cargo {
    margin-top: 10px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.1875rem;
    line-height: 1.3;
    color: var(--soft);
  }

  .exp-resumen {
    margin-top: clamp(12px, 2.4vh, 22px);
    max-width: 46ch;
    color: var(--soft);
    text-wrap: pretty;
  }

  .chips {
    margin-top: clamp(12px, 2.4vh, 22px);
  }

  .exp-proyecto {
    padding-left: clamp(22px, 3vw, 40px);
    border-left: 1px solid var(--line);
  }

  .exp-nombre {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.25rem);
    line-height: 1.05;
  }

  .exp-desc {
    margin-top: 8px;
    max-width: 62ch;
    text-wrap: pretty;
  }

  .aportes {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 26px;
    margin-top: clamp(10px, 2.2vh, 22px);
  }

  .aportes li {
    padding: clamp(8px, 1.5vh, 14px) 0;
    border-top: 1px solid var(--line2);
  }

  .aportes h4 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--t-chico);
    font-weight: 600;
  }

  .aportes .ic {
    color: var(--teal);
  }

  .aportes p {
    margin-top: 3px;
    font-size: var(--t-chico);
    line-height: 1.45;
    color: var(--soft);
    text-wrap: pretty;
  }

  .exp-nota {
    margin-top: 8px;
    font-family: var(--mono);
    font-size: var(--t-micro);
    color: var(--faint);
  }

  @media (max-width: 899px) {
    .exp {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .exp-proyecto {
      padding: 22px 0 0;
      border-left: none;
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 479px) {
    .aportes {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
