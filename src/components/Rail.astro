---
/*
  Riel lateral de navegacion (.rail), fijo a la derecha, centrado vertical, z-index 85.
  Se renderiza en build desde ESCENAS (enlaces reales, funcionan sin JS); navegacion.ts marca
  el activo. Oculto en <=1024px. Estilos en global.css (chrome global).
*/
import { ESCENAS } from '../data/escenas';
import { obtenerIdioma, obtenerTextos } from '../i18n/ui';

const t = obtenerTextos(obtenerIdioma(Astro.currentLocale));
---

<nav class="rail" aria-label={t.aria.navegacion} data-rail>
  {
    ESCENAS.map((clave, i) => (
      <a
        class:list={['rail-dot', { on: i === 0 }]}
        href={`#${clave}`}
        aria-label={`${t.aria.irA}${t.slates[clave]}`}
        aria-current={i === 0 ? 'true' : undefined}
      >
        <span class="rail-label" aria-hidden="true">{t.slates[clave]}</span>
        <span class="rail-pip" aria-hidden="true" />
      </a>
    ))
  }
</nav>
